# Développement local : copier en .env et compléter. Production (Dokploy) : mêmes variables dans
# l'onglet « Environment » — voir compose.image.yml. Ne jamais committer .env.

ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://kortex:kortex@localhost:5432/kortex_prospect
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:3100
PUBLIC_URL=http://localhost:3100

# --- LLM : toute API compatible OpenAI ---
#   DeepSeek  : LLM_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-chat
#   Mistral   : LLM_BASE_URL=https://api.mistral.ai/v1        LLM_MODEL=mistral-large-latest
#   Groq      : LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   Ollama    : LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen2.5:14b   LLM_API_KEY=ollama
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.4

# --- Recherche web (https://app.tavily.com) ---
TAVILY_API_KEY=

# --- Secrets ---
# SECRET_KEY (Fernet, chiffre les jetons et signe les liens de désinscription) :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
# TOKEN_SECRET_KEY (signe les sessions) : python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRET_KEY=

# --- Connexion WhatsApp (gowa, comme Foody) ---
# Numéros autorisés, séparés par des virgules. En dev, laisser vide = pas de connexion requise.
ADMIN_PHONES=
GOWA_URL=
GOWA_BASIC_USER=
GOWA_BASIC_PASS=

# --- Envoi par lots + suivi des réponses : SMTP / IMAP Zoho ---
# Offre Zoho payante requise (IMAP/SMTP absents de l'offre gratuite). Activer IMAP dans Zoho Mail,
# puis créer un « mot de passe d'application » si la double authentification est active.
MAIL_USER=
MAIL_PASSWORD=
SMTP_HOST=smtp.zoho.com
IMAP_HOST=imap.zoho.com
SENDER_EMAIL=contact@kortexdigital.net
SENDER_NAME=Shalom Tehe - KORTEX DIGITAL
CAMPAIGN_DAILY_MAX=30
CAMPAIGN_HOURS=8-17

# --- Brouillons Zoho Mail via API (facultatif) ---
# Redirect URI à déclarer : <PUBLIC_URL>/api/email/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_MAIL_DOMAIN=https://mail.zoho.com
